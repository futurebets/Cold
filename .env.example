# Copy to .env for local runs. Everything is optional in development.

# PostgreSQL connection. Leave empty to use the embedded PGlite database in DATA_DIR (dev only).
DATABASE_URL=

# 32+ random characters. Encrypts stored integration credentials. Required in production.
APP_SECRET=

PORT=8080
DATA_DIR=./data

# Set to false on extra replicas so background jobs run exactly once.
JOBS_ENABLED=true

# Seed a simulated demo workspace on first boot (or run `npm run demo`).
DEMO=false
